{
  "name": "kimiburn-release-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Release tooling for Kimiburn. Kimiburn is a Go application and is not published to npm.",
  "engines": {
    "node": ">=26.13"
  },
  "scripts": {
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "commitlint": "commitlint",
    "check:release-notes": "node scripts/check-release-notes.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "14.0.0-beta.4",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/release-notes-generator": "15.0.0-beta.3",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "semantic-release": "26.0.1"
  }
}
